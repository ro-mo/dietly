<div class="min-h-screen bg-gray-50 dark:bg-gray-900">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Nuovo appuntamento</h1>

      <%= form_with(model: [:doctors, @appointment], url: doctors_appointments_path, method: :post, class: "space-y-6") do |f| %>
        <% if @appointment.errors.any? %>
          <div class="bg-red-50 dark:bg-red-900/50 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 px-4 py-3 rounded relative mb-4" role="alert">
            <h2 class="font-bold"><%= pluralize(@appointment.errors.count, "errore") %> da correggere:</h2>
            <ul class="list-disc list-inside">
              <% @appointment.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
          <div class="space-y-6">
            <div>
              <%= f.label :patient_id, "Seleziona il paziente", class: "block text-sm font-medium text-gray-600 dark:text-gray-400" %>
              <%= f.collection_select :patient_id, @patients, :id, :full_name, 
                  { prompt: "Seleziona un paziente" }, 
                  class: "mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-md focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:ring-marmorean-500 dark:focus:ring-marmorean-400 sm:text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white" %>
            </div>

            <div>
              <%= f.label :start_time, "Data e ora di inizio", class: "block text-sm font-medium text-gray-600 dark:text-gray-400" %>
              <%= f.datetime_local_field :start_time, 
                  class: "mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-md focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:ring-marmorean-500 dark:focus:ring-marmorean-400 sm:text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white" %>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">L'appuntamento durerà 20 minuti</p>
            </div>

            <div>
              <%= f.label :notes, "Note", class: "block text-sm font-medium text-gray-600 dark:text-gray-400" %>
              <%= f.text_area :notes, 
                  class: "mt-1 block w-full rounded-md border-gray-300 dark:border-gray-600 shadow-md focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:ring-marmorean-500 dark:focus:ring-marmorean-400 sm:text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white",
                  rows: 4 %>
            </div>
          </div>
        </div>

        <div class="flex justify-end space-x-4">
          <%= link_to 'Annulla', root_path, 
              class: "px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm hover:bg-gray-50 dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-marmorean-500 dark:focus:ring-marmorean-400 transition-colors duration-300" %>
          <%= f.submit "Crea appuntamento", 
              class: "px-4 py-2 text-sm font-medium text-white bg-marmorean-500 dark:bg-marmorean-600 border border-transparent rounded-md shadow-sm hover:bg-marmorean-600 dark:hover:bg-marmorean-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-marmorean-500 dark:focus:ring-marmorean-400 transition-colors duration-300" %>
        </div>
      <% end %>
    </div>
  </div>
</div> 