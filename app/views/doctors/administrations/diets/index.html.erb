<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Gestione Diete</h1>
    <div class="flex space-x-4">
      <%= link_to "Torna alla gestione pazienti", doctors_administrations_patients_management_path, class: "px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors duration-300" %>
      <%= link_to "Crea Nuova Dieta", new_doctors_administrations_diet_path(patient_id: params[:patient_id].presence), class: "px-4 py-2 bg-marmorean-500 text-white rounded-lg hover:bg-marmorean-600 transition-colors duration-300" %>
    </div>
  </div>

  <%= form_with url: doctors_administrations_diets_path, method: :get, local: true, class: "mb-4" do %>
    <div class="flex items-center space-x-2">
      <%= select_tag :patient_id, 
                     options_from_collection_for_select(@patients || Current.user.patients, :id, :full_name, params[:patient_id]), 
                     prompt: "Filtra per paziente", 
                     class: "form-select", 
                     id: "patient_filter",
                     onchange: "this.form.submit();" %>
      <% if params[:patient_id].present? %>
        <%= link_to "Rimuovi filtro", doctors_administrations_diets_path, class: "ml-2 text-sm text-gray-500 underline" %>
      <% end %>
    </div>
  <% end %>

  <% if params[:patient_id].present? && @patient %>
    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-4 dark:bg-blue-900 dark:border-blue-700">
      <p class="text-blue-700 dark:text-blue-300">
        <strong>Filtro attivo:</strong> Diete per <%= @patient.full_name %>
      </p>
    </div>
  <% end %>

  <% if @diet_plans.present? %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-700">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Paziente</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Titolo Piano</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Data Inizio</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Data Fine</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Stato</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Azioni</th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% @diet_plans.each do |diet| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900 dark:text-white">
                  <%= diet.patient&.full_name || "Paziente non trovato" %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500 dark:text-gray-400">
                  <%= diet.title %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500 dark:text-gray-400">
                  <%= l(diet.start_date, format: :short) if diet.start_date %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-gray-500 dark:text-gray-400">
                  <%= l(diet.end_date, format: :short) if diet.end_date %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if diet.active? %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">
                    Attiva
                  </span>
                <% else %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-100 text-gray-800 dark:bg-gray-900 dark:text-gray-200">
                    Inattiva
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <%= link_to "Modifica", edit_doctors_administrations_diet_path(diet), class: "text-marmorean-600 hover:text-marmorean-900 dark:text-marmorean-400 dark:hover:text-marmorean-300 mr-3" %>
                <%= link_to "Elimina", doctors_administrations_diet_path(diet), data: { turbo_method: :delete, turbo_confirm: "Sei sicuro di voler eliminare questo piano dietetico?" }, class: "text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 text-center">
      <p class="text-gray-500 dark:text-gray-400">Non ci sono piani dietetici da mostrare.</p>
      <% if params[:patient_id].present? && @patient %>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-2">Non ci sono diete per <%= @patient.full_name %>.</p>
      <% else %>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-2">Crea un nuovo piano dietetico per iniziare.</p>
      <% end %>
    </div>
  <% end %>
</div>