<%# Determina l'URL corretto in base allo stato del record %>
<% url = diet_plan.persisted? ? doctors_administrations_diet_path(diet_plan) : doctors_administrations_diets_path %>

<%= form_with(model: diet_plan, url: url, scope: :diet_plan, class: "space-y-6", data: { controller: "nested-form" }) do |form| %>
  <% if diet_plan.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
      <strong class="font-bold">Errore!</strong>
      <span class="block sm:inline">Non è stato possibile salvare il piano dietetico:</span>
      <ul class="list-disc list-inside">
        <% diet_plan.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Campi Principali DietPlan %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <%# Mostra nome paziente (non modificabile) e campo nascosto %>
      <%= form.label :patient_id, "Paziente", class: "block text-sm font-medium text-gray-700" %>
      <% patient_name = @patient&.full_name || (@diet_plan.patient&.full_name || "Non selezionato") %>
      <p class="mt-1 block w-full rounded-md border-gray-300 bg-gray-100 px-3 py-2 shadow-sm sm:text-sm"><%= patient_name %></p>
      <%= form.hidden_field :patient_id %>
    </div>
    <div>
      <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= form.label :active, class: "block text-sm font-medium text-gray-700" %>
      <%= form.check_box :active, class: "mt-1 rounded border-gray-300 text-indigo-600 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= form.label :start_date, class: "block text-sm font-medium text-gray-700" %>
      <%= form.date_field :start_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
    <div>
      <%= form.label :end_date, class: "block text-sm font-medium text-gray-700" %>
      <%= form.date_field :end_date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>
  </div>
  <div>
    <%= form.label :notes, "Note Generali Piano", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :notes, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <hr class="my-6">

  <%# Template per i nuovi campi mealfood %>
  <% template = render 'mealfood_fields', form: form, index: 'NEW_RECORD' %>
  <% encoded_template = URI.encode_www_form_component(template) %>

  <%# Menu Giornalieri %>
  <div class="space-y-6">
    <%= form.fields_for :daily_menus do |menu_form| %>
      <div class="border rounded-lg p-4 bg-white shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
          <div>
            <%= menu_form.label :day_of_week, "Giorno", class: "block text-sm font-medium text-gray-700" %>
            <%= menu_form.select :day_of_week, 
                options_for_select([
                  ['Lunedì', 1], ['Martedì', 2], ['Mercoledì', 3],
                  ['Giovedì', 4], ['Venerdì', 5], ['Sabato', 6], ['Domenica', 7]
                ], menu_form.object.day_of_week),
                { include_blank: 'Seleziona giorno' },
                class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
          </div>
          <%= menu_form.hidden_field :id %>
          <%= menu_form.hidden_field :_destroy %>
        </div>

        <%# Pasti %>
        <div class="space-y-4">
          <%= menu_form.fields_for :meals do |meal_form| %>
            <div class="border rounded p-4 bg-gray-50">
              <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                <div>
                  <%= meal_form.label :meal_type, "Tipo Pasto", class: "block text-sm font-medium text-gray-700" %>
                  <%= meal_form.select :meal_type,
                      options_for_select([
                        ['Colazione', 'breakfast'],
                        ['Pranzo', 'lunch'],
                        ['Cena', 'dinner'],
                        ['Spuntino', 'snack']
                      ], meal_form.object.meal_type),
                      { include_blank: 'Seleziona tipo' },
                      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
                <%= meal_form.hidden_field :id %>
                <%= meal_form.hidden_field :_destroy %>
              </div>

              <%# Ingredienti %>
              <div class="mealfoods-container space-y-2">
                <%= meal_form.fields_for :mealfoods do |mealfood_form| %>
                  <%= render 'mealfood_fields', form: mealfood_form %>
                <% end %>
              </div>

              <%# Pulsante Aggiungi Ingrediente %>
              <button type="button"
                      class="mt-2 text-sm text-indigo-600 hover:text-indigo-800"
                      data-action="nested-form#add"
                      data-template-html="<%= encoded_template %>">
                + Aggiungi Ingrediente
              </button>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Pulsanti di azione %>
  <div class="flex justify-end space-x-4">
    <%= link_to "Annulla", doctors_administrations_diets_path, class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <%= form.submit class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-md shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  </div>
<% end %>

<%# Template per i campi MealFood (usato da JavaScript) %>
<template id="mealfood-template">
  <%# Questo contenuto viene riempito dinamicamente dal JS usando l'HTML escapato nel data attribute del bottone %>
</template> 