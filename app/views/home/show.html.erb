<% if authenticated? %>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col">
    <!-- Header Navigation -->
    <header class="bg-white dark:bg-gray-800 shadow-md top-0 w-full z-10">
      <div class="container mx-auto px-4">
        <div class="flex justify-between items-center h-16">
          <a href="<%= root_path %>" class="flex items-center text-2xl font-bold text-marmorean-600 dark:text-marmorean-400">
            <div class="w-8 h-8 mr-2 rounded-full bg-gradient-to-r from-marmorean-400 to-marmorean-600 flex items-center justify-center shadow-lg">
              <img class="w-5 h-5" src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/logo.svg" alt="logo">
            </div>
            Dietly
          </a>
          
          <nav class="flex items-center space-x-4">
            <% if Current.user.is_a?(Patient) %>
              <%= link_to "Storico Diete", patients_administrations_diet_history_path, 
                class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-marmorean-600 dark:text-gray-300 dark:hover:text-marmorean-400 transition-colors duration-300" %>
              <%= link_to "Appuntamenti", patients_administrations_my_appointments_path, 
                class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-marmorean-600 dark:text-gray-300 dark:hover:text-marmorean-400 transition-colors duration-300" %>
              <%= link_to "Profilo", patients_profile_path, 
                class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-marmorean-600 dark:text-gray-300 dark:hover:text-marmorean-400 transition-colors duration-300" %>
            <% else %>
              <%= link_to "Gestione Pazienti", doctors_administrations_patients_management_path, 
                class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-marmorean-600 dark:text-gray-300 dark:hover:text-marmorean-400 transition-colors duration-300" %>
              <%= link_to "Nuovo Appuntamento", new_doctors_appointment_path, 
                class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-marmorean-600 dark:text-gray-300 dark:hover:text-marmorean-400 transition-colors duration-300" %>
            <% end %>
            <%= button_to "Logout", session_path, 
              method: :delete, 
              class: "px-4 py-2 text-sm font-medium text-white bg-marmorean-500 hover:bg-marmorean-600 rounded-lg shadow-md transition-colors duration-300 ease-in-out dark:bg-marmorean-600 dark:hover:bg-marmorean-700" %>
          </nav>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8 flex-grow">
      <% if Current.user.is_a?(Patient) %>
        <% if @current_diet %>
          <!-- Diet Info -->
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 mb-8">
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
              <%= @current_diet.title %>
            </h1>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
              <div>
                <p class="text-sm text-gray-600 dark:text-gray-400">Data di inizio</p>
                <p class="text-gray-900 dark:text-white"><%= l(@current_diet.start_date, format: :long) %></p>
              </div>
              <div>
                <p class="text-sm text-gray-600 dark:text-gray-400">Data di fine</p>
                <p class="text-gray-900 dark:text-white"><%= l(@current_diet.end_date, format: :long) %></p>
              </div>
            </div>
            <% if @current_diet.notes.present? %>
              <div class="mt-4">
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Note</p>
                <p class="text-gray-900 dark:text-white"><%= @current_diet.notes %></p>
              </div>
            <% end %>
          </div>

          <!-- Today's Meals -->
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 mb-8">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">
              Pasti di <%= l(Date.today, format: :long) %>
            </h2>
            
            <% today_menu = @current_diet.daily_menus.find_by(day_of_week: Date.today.wday) %>
            <% if today_menu %>
              <div class="space-y-6">
                <% today_menu.meals.each do |meal| %>
                  <div class="border-b border-gray-200 dark:border-gray-700 pb-6 last:border-0 last:pb-0">
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                      <%= meal.formatted_meal_type %>
                    </h3>
                    <p class="text-md font-medium text-marmorean-600 dark:text-marmorean-400 mb-3">
                      <%= meal.description %>
                    </p>
                    
                    <div class="ml-4 space-y-4">
                      <div>
                        <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Ingredienti:</p>
                        <ul class="list-disc list-inside space-y-1">
                          <% meal.mealfoods.each do |mealfood| %>
                            <li class="text-gray-900 dark:text-white">
                              <%= mealfood.ingredient_name %> - <%= mealfood.quantity %> <%= mealfood.unit %>
                            </li>
                          <% end %>
                        </ul>
                      </div>

                      <% if meal.preparation_instructions.present? %>
                        <div>
                          <p class="text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Preparazione:</p>
                          <div class="text-gray-900 dark:text-white whitespace-pre-line">
                            <%= meal.preparation_instructions %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-gray-600 dark:text-gray-400">
                Nessun pasto programmato per oggi
              </p>
            <% end %>
          </div>

          <!-- Weekly Shopping List -->
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">
              Lista della Spesa Settimanale
            </h2>
            
            <% shopping_list = @current_diet.shopping_list %>
            <% if shopping_list.any? %>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                <% shopping_list.each do |ingredient_name, data| %>
                  <div class="flex items-center space-x-4 p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
                    <div class="flex-1">
                      <p class="text-gray-900 dark:text-white"><%= ingredient_name %></p>
                      <p class="text-sm text-gray-600 dark:text-gray-400">
                        <%= data[:quantity] %> <%= data[:unit] %>
                      </p>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-gray-600 dark:text-gray-400">
                Nessun ingrediente nella lista della spesa
              </p>
            <% end %>
          </div>
        <% else %>
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 text-center">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
              Nessuna dieta attiva
            </h2>
            <p class="text-gray-600 dark:text-gray-400">
              Non hai ancora una dieta attiva. Contatta il tuo nutrizionista per iniziare il tuo percorso.
            </p>
          </div>
        <% end %>
      <% else %>
        <!-- Doctor's Appointments -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
          <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">
            I tuoi prossimi appuntamenti
          </h2>
          
          <% if @upcoming_appointments.any? %>
            <div class="space-y-6">
              <% @upcoming_appointments.each do |appointment| %>
                <div class="border-b border-gray-200 dark:border-gray-700 pb-6 last:border-0 last:pb-0">
                  <div class="flex justify-between items-start">
                    <div>
                      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                        <%= appointment.patient.full_name %>
                      </h3>
                      <p class="text-sm text-gray-600 dark:text-gray-400">
                        <%= l(appointment.start_time, format: :long) %>
                      </p>
                      <p class="text-sm text-gray-600 dark:text-gray-400">
                        <%= appointment.notes %>
                      </p>
                    </div>
                    <div class="flex items-center space-x-2">
                      <%= link_to "Modifica", edit_doctors_appointment_path(appointment), 
                        class: "px-3 py-1 text-sm font-medium text-marmorean-600 hover:text-marmorean-700 dark:text-marmorean-400 dark:hover:text-marmorean-300 transition-colors duration-300" %>
                      <%= button_to "Elimina", doctors_appointment_path(appointment), 
                        method: :delete,
                        class: "px-3 py-1 text-sm font-medium text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 transition-colors duration-300",
                        data: { confirm: "Sei sicuro di voler eliminare questo appuntamento?" } %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center">
              <p class="text-gray-600 dark:text-gray-400">
                Non hai appuntamenti programmati
              </p>
            </div>
          <% end %>
        </div>
      <% end %>
    </main>
    <footer class="bg-white dark:bg-gray-800 p-6 w-full">
      <p class="text-gray-600 dark:text-gray-400 text-center">
        &copy; <%= Time.current.year %> Dietly. Tutti i diritti riservati.
      </p>
    </footer>
  </div>
<% else %>
  <%= render "home/landing" %>
<% end %>
