<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold mb-6">Profilo Utente</h1>

    <div class="space-y-6">
      <div class="grid grid-cols-2 gap-4">
        <div>
          <h3 class="text-gray-600 font-semibold">Nome</h3>
          <p class="text-lg"><%= @patient.first_name %></p>
        </div>
        <div>
          <h3 class="text-gray-600 font-semibold">Cognome</h3>
          <p class="text-lg"><%= @patient.last_name %></p>
        </div>
      </div>

      <div>
        <h3 class="text-gray-600 font-semibold">Email</h3>
        <p class="text-lg"><%= @patient.email_address %></p>
      </div>

      <div>
        <h3 class="text-gray-600 font-semibold">Telefono</h3>
        <p class="text-lg"><%= @patient.phone || "Non specificato" %></p>
      </div>

      <div>
        <h3 class="text-gray-600 font-semibold">Data di Nascita</h3>
        <p class="text-lg"><%= @patient.date_of_birth&.strftime("%d/%m/%Y") || "Non specificata" %></p>
      </div>

      <div>
        <h3 class="text-gray-600 font-semibold">Genere</h3>
        <p class="text-lg">
          <% case @patient.gender %>
          <% when "M" %>
            Maschio
          <% when "F" %>
            Femmina
          <% when "O" %>
            Altro
          <% else %>
            Non specificato
          <% end %>
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <h3 class="text-gray-600 font-semibold">Altezza</h3>
          <p class="text-lg"><%= @patient.height ? "#{@patient.height} cm" : "Non specificata" %></p>
        </div>
        <div>
          <h3 class="text-gray-600 font-semibold">Peso</h3>
          <p class="text-lg"><%= @patient.weight ? "#{@patient.weight} kg" : "Non specificato" %></p>
        </div>
      </div>

      <div>
        <h3 class="text-gray-600 font-semibold">Indirizzo</h3>
        <p class="text-lg"><%= @patient.address || "Non specificato" %></p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <h3 class="text-gray-600 font-semibold">Città</h3>
          <p class="text-lg"><%= @patient.city || "Non specificata" %></p>
        </div>
        <div>
          <h3 class="text-gray-600 font-semibold">CAP</h3>
          <p class="text-lg"><%= @patient.postal_code || "Non specificato" %></p>
        </div>
      </div>
    </div>

    <div class="mt-8 flex justify-end space-x-4">
      <%= link_to "Indietro", root_path, class: "bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2 px-4 rounded" %>
      <%= link_to "Modifica", edit_patients_profile_path, class: "bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded" %>
    </div>
  </div>
</div> 