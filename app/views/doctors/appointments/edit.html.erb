<div class="min-h-screen bg-gray-50 dark:bg-gray-900 flex flex-col">
  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8 flex-grow">
    <div class="max-w-2xl mx-auto">
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Modifica appuntamento</h1>

        <%# Usa il path helper corretto per l'update e specifica il model namespacizzato %>
        <%= form_with(model: [:doctors, @appointment], url: doctors_appointment_path(@appointment), method: :patch, class: "space-y-6") do |f| %>
          <% if @appointment.errors.any? %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
              <h2 class="font-bold"><%= pluralize(@appointment.errors.count, "errore") %> da correggere:</h2>
              <ul class="list-disc list-inside">
                <% @appointment.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="form-group">
            <%= f.label :patient_id, "Paziente", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
            <%= f.collection_select :patient_id, @patients, :id, :full_name, 
                {}, 
                class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-marmorean-500 focus:border-marmorean-500 sm:text-sm rounded-md text-gray-900 dark:text-white" %>
          </div>

          <div class="form-group">
            <%= f.label :start_time, "Data e ora di inizio", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
            <%= f.datetime_local_field :start_time, value: @appointment.start_time&.strftime('%Y-%m-%dT%H:%M'),
                class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-marmorean-500 focus:border-marmorean-500 sm:text-sm rounded-md text-gray-900 dark:text-white" %>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">L'appuntamento durerà 20 minuti</p>
          </div>

          <div class="form-group">
            <%= f.label :notes, "Note", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
            <%= f.text_area :notes, 
                class: "mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-marmorean-500 focus:border-marmorean-500 sm:text-sm rounded-md text-gray-900 dark:text-white",
                rows: 4 %>
          </div>

          <div class="flex justify-end space-x-4">
            <%# Usa il path helper corretto per Annulla %>
            <%= link_to 'Annulla', root_path, 
                class: "px-4 py-2 text-sm font-medium text-gray-700 hover:text-marmorean-600 dark:text-gray-300 dark:hover:text-marmorean-400 transition-colors duration-300" %>
            <%= f.submit "Salva modifiche", 
                class: "px-4 py-2 text-sm font-medium text-white bg-marmorean-500 hover:bg-marmorean-600 rounded-lg shadow-md transition-colors duration-300 ease-in-out dark:bg-marmorean-600 dark:hover:bg-marmorean-700" %>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div> 