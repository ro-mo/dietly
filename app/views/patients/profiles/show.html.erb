<div class="min-h-screen bg-gray-50 dark:bg-gray-900">
  <div class="container mx-auto px-4 py-8 flex-grow">
    <div class="max-w-2xl mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
      <h1 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Profilo Utente</h1>

      <div class="space-y-6">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Nome</h3>
            <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.first_name %></p>
          </div>
          <div>
            <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Cognome</h3>
            <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.last_name %></p>
          </div>
        </div>

        <div>
          <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Email</h3>
          <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.email_address %></p>
        </div>

        <div>
          <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Telefono</h3>
          <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.phone || "Non specificato" %></p>
        </div>

        <div>
          <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Data di Nascita</h3>
          <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.date_of_birth&.strftime("%d/%m/%Y") || "Non specificata" %></p>
        </div>

        <div>
          <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Genere</h3>
          <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm">
            <% case @patient.gender %>
            <% when "M" %>
              Maschio
            <% when "F" %>
              Femmina
            <% when "O" %>
              Altro
            <% else %>
              Non specificato
            <% end %>
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Altezza</h3>
            <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.height ? "#{@patient.height} cm" : "Non specificata" %></p>
          </div>
          <div>
            <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Peso</h3>
            <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.weight ? "#{@patient.weight} kg" : "Non specificato" %></p>
          </div>
        </div>

        <div>
          <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Indirizzo</h3>
          <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.address || "Non specificato" %></p>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <h3 class="text-gray-600 dark:text-gray-400 font-semibold">Città</h3>
            <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.city || "Non specificata" %></p>
          </div>
          <div>
            <h3 class="text-gray-600 dark:text-gray-400 font-semibold">CAP</h3>
            <p class="text-base text-gray-900 dark:text-white bg-white dark:bg-gray-700 px-3 py-2 rounded-lg shadow-sm"><%= @patient.postal_code || "Non specificato" %></p>
          </div>
        </div>
      </div>

      <div class="mt-8 flex justify-end space-x-4">
        <%= link_to "Indietro", root_path, class: "bg-gray-500 hover:bg-gray-600 dark:bg-gray-600 dark:hover:bg-gray-700 text-white font-semibold py-2 px-4 rounded transition-colors duration-300" %>
        <%= link_to "Modifica", edit_patients_profile_path, class: "bg-marmorean-500 hover:bg-marmorean-600 dark:bg-marmorean-600 dark:hover:bg-marmorean-700 text-white font-semibold py-2 px-4 rounded transition-colors duration-300" %>
      </div>
    </div>
  </div>
</div> 