<div class="min-h-screen bg-gray-50 dark:bg-gray-900">
  <div class="container mx-auto px-4 py-8">
    <div class="max-w-2xl mx-auto bg-white dark:bg-gray-800 rounded-lg shadow-md p-6">
      <h1 class="text-2xl font-bold mb-6 text-gray-900 dark:text-white">Modifica Profilo</h1>

      <%= form_with(model: @patient, url: patients_profile_path, method: :patch, local: true, class: "space-y-6") do |f| %>
        <% if @patient.errors.any? %>
          <div class="bg-red-50 dark:bg-red-900/50 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 px-4 py-3 rounded">
            <h2 class="font-semibold mb-2">
              <%= pluralize(@patient.errors.count, "errore") %> impediscono il salvataggio del profilo:
            </h2>
            <ul class="list-disc list-inside">
              <% @patient.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :first_name, "Nome", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
            <%= f.text_field :first_name, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
          </div>
          <div>
            <%= f.label :last_name, "Cognome", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
            <%= f.text_field :last_name, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
          </div>
        </div>

        <div>
          <%= f.label :email_address, "Email", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
          <%= f.email_field :email_address, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :phone, "Telefono", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
          <%= f.telephone_field :phone, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :date_of_birth, "Data di Nascita", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
          <%= f.date_field :date_of_birth, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :gender, "Genere", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
          <%= f.select :gender, 
              options_for_select([["Maschio", "M"], ["Femmina", "F"], ["Altro", "O"]], @patient.gender),
              { include_blank: "Seleziona..." },
              class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :height, "Altezza (cm)", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
            <%= f.number_field :height, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
          </div>
          <div>
            <%= f.label :weight, "Peso (kg)", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
            <%= f.number_field :weight, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
          </div>
        </div>

        <div>
          <%= f.label :address, "Indirizzo", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
          <%= f.text_field :address, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :city, "Città", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
            <%= f.text_field :city, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
          </div>
          <div>
            <%= f.label :postal_code, "CAP", class: "block text-gray-600 dark:text-gray-400 font-semibold mb-1" %>
            <%= f.text_field :postal_code, class: "w-full border-2 border-gray-300 dark:border-gray-600 rounded px-3 py-2 bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:border-marmorean-500 dark:focus:border-marmorean-400 focus:outline-none" %>
          </div>
        </div>

        <div class="mt-8 flex justify-end space-x-4">
          <%= link_to "Annulla", patients_profile_path, class: "bg-gray-500 hover:bg-gray-600 dark:bg-gray-600 dark:hover:bg-gray-700 text-white font-semibold py-2 px-4 rounded transition-colors duration-300" %>
          <%= f.submit "Salva Modifiche", class: "bg-marmorean-500 hover:bg-marmorean-600 dark:bg-marmorean-600 dark:hover:bg-marmorean-700 text-white font-semibold py-2 px-4 rounded transition-colors duration-300" %>
        </div>
      <% end %>
    </div>
  </div>
</div> 